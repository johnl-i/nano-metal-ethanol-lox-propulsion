f_loading = 0.05   # 1% loading to visualize
eta_cases = [0.5, 0.8]

Q_Al = 3.11e7      # J/kg-Al (thermochemical max; eta handles effective in-chamber)

tau_s = 0.005      # 5 ms heat-release pulse duration

qtot_cases = {eta: eta * f_loading * Q_Al for eta in eta_cases}
qtot_cases

import cantera as ct
gas = ct.Solution("gri30.yaml")

X_products = {"N2": 0.75, "H2O": 0.15, "CO2": 0.10}

P0 = ct.one_atm
T0 = 15.0e5
gas.TPX = T0, P0, X_products

gas.cp_mass


import numpy as np
def triangular_pulse(t, tau, qtot):
    if t < 0 or t > tau:
        return 0.0
    qdot_peak = 2.0 * qtot / tau  # area = 0.5 * tau * qdot_peak = qtot
    if t <= tau / 2:
        return qdot_peak * (t / (tau / 2))
    return qdot_peak * ((tau - t) / (tau / 2))

def integrate_qdot(tau, qtot, n=2000):
    ts = np.linspace(0, tau, n)
    qdot = np.array([triangular_pulse(t, tau, qtot) for t in ts])
    return np.trapz(qdot, ts)

for eta, qtot in qtot_cases.items():
    print("eta=", eta, "integral=", integrate_qdot(tau_s, qtot))

def simulate_temperature_history(T0, P0, gas, X, tau, qtot, t_end=0.03, dt=1e-5):
    ts = np.arange(0.0, t_end + dt, dt)
    T = np.zeros_like(ts)
    T[0] = T0

    for i in range(len(ts) - 1):
        t = ts[i]
        gas.TPX = T[i], P0, X
        cp = gas.cp_mass
        qdot = triangular_pulse(t, tau, qtot)
        T[i + 1] = T[i] + (qdot / cp) * dt

    return ts, T

t_end = 0.03
dt = 1e-5

histories = {}
for eta, qtot in qtot_cases.items():
    ts, Tt = simulate_temperature_history(T0, P0, gas, X_products, tau_s, qtot, t_end=t_end, dt=dt)
    histories[eta] = (ts, Tt)

baseline = (ts, np.full_like(ts, T0))

import pandas as pd
import matplotlib.pyplot as plt
plt.figure(figsize=(8,4))
plt.plot(baseline[0], baseline[1], linewidth=2, label="Baseline (no pulse)")

for eta, (ts, Tt) in histories.items():
    plt.plot(ts, Tt, linewidth=2, label=f"Heat pulse (η={eta}, f={f_loading:.2%})")

plt.xlabel("Time (s)")
plt.ylabel("Temperature (K)")
plt.title(f"Cantera Cp(T) heat‑pulse snapshot (tau={tau_s*1e3:.1f} ms)")
plt.grid(True, alpha=0.3)
plt.legend()
plt.show()

Isp0 = 342.869769
import math
def isp_scaled_with_temperature(Isp0, T0, Tnew):
    return Isp0 * math.sqrt(Tnew / T0)

for eta, (ts, Tt) in histories.items():
    Tend = float(Tt[-1])
    dT_end = Tend - T0
    Isp_new = isp_scaled_with_temperature(Isp0, T0, Tend)
    dIsp = Isp_new - Isp0
    print(f"eta={eta:0.2f}  Tend={Tend:0.1f} K  ΔT_end={dT_end:0.1f} K  ΔIsp={dIsp:0.2f} s")

f_sweep = np.array([0.00, 0.01, 0.03, 0.05])
eta_cases2 = [0.5, 0.8]

dIsp_end = {eta: [] for eta in eta_cases2}

for f in f_sweep:
    for eta in eta_cases2:
        qtot = eta * f * Q_Al
        ts, Tt = simulate_temperature_history(T0, P0, gas, X_products, tau_s, qtot, t_end=t_end, dt=dt)
        Tend = float(Tt[-1])
        dIsp_end[eta].append(isp_scaled_with_temperature(Isp0, T0, Tend) - Isp0)

plt.figure(figsize=(7,4))
for eta in eta_cases2:
    plt.plot(f_sweep, dIsp_end[eta], marker="o", linewidth=2, label=f"η={eta}")
plt.xlabel("Nano‑Al mass fraction f")
plt.ylabel("ΔIsp (s) from pulse endpoint")
plt.title("ΔIsp vs nano‑Al loading (heat‑pulse snapshot)")
plt.grid(True, alpha=0.3)
plt.legend()
plt.show()
