out_csv


plt.figure(figsize=(7,4))
plt.plot(df["MR_O_F"], df["Isp_vac_s"], marker="o", markersize=2, linewidth=1)
plt.xlabel("Mixture Ratio (O/F)")
plt.ylabel("Vacuum Specific Impulse Isp,vac (s)")
plt.title(f"Ethanol/LOX baseline: Isp vs MR (Pc={Pc_bar:.1f} bar, eps={eps:.0f})")
plt.grid(True, alpha=0.3)
plt.show()

plt.figure(figsize=(7,4))
plt.plot(df["MR_O_F"], df["Tcomb_K"], marker="o", markersize=2, linewidth=1)
plt.xlabel("Mixture Ratio (O/F)")
plt.ylabel("Combustion Temperature Tcomb (K)")
plt.title(f"Ethanol/LOX baseline: Tcomb vs MR (Pc={Pc_bar:.1f} bar)")
plt.grid(True, alpha=0.3)
plt.show()

import numpy as np

f = [0, 0.01, 0.03, 0.05]
nc = np.arange(0.5, 0.8)
Q_Al = 3.1e7 #iffy value, get citation later.

dq = f * nc * Q_Al


R_univ = 8.314462618  # J/mol/K
M = mw / 1000.0    # kg/mol
R_spec = R_univ / M   # J/kg/K
Cp_eff = gamma * R_spec / (gamma - 1.0)
T_old = best["Tcomb_K"]
dT = dq/Cp_eff
T_new = T_old + dT

Isp_new = isp_vac_s * np.sqrt(T_new / T_old)

print(R_spec)
print(Cp_eff)
print(dT)
print(T_new)

