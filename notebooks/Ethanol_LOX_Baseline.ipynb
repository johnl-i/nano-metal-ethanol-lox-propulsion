import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from math import isnan

try:
    from rocketcea.cea_obj import CEA_Obj
except Exception as e:
    raise RuntimeError(
        "RocketCEA import failed. Run: `pip install rocketcea` then restart kernel.\n"
        f"Original error: {e}"
    )
Pc_bar = 15.0          # chamber pressure [bar]
eps = 40.0             # nozzle area ratio Ae/At (choose a representative vacuum nozzle)
MR_min, MR_max = 1.0, 2.6
MR_step = 0.05

# RocketCEA uses Pc in psia
BAR_TO_PSIA = 14.5037738
Pc_psia = Pc_bar * BAR_TO_PSIA

MR_grid = np.round(np.arange(MR_min, MR_max + 1e-9, MR_step), 5)
MR_grid[:5], MR_grid[-5:], len(MR_grid)

def make_cea_ethanol_lox():
    ox_candidates = ["LOX", "LO2", "O2(L)"]
    fuel_candidates = ["Ethanol", "C2H5OH", "C2H5OH(L)", "ALCOHOL"]

    last_err = None
    for ox in ox_candidates:
        for fu in fuel_candidates:
            try:
                cea = CEA_Obj(oxName=ox, fuelName=fu)
                # quick probe call to confirm it works
                _ = cea.get_Tcomb(Pc=Pc_psia, MR=MR_grid[0])
                print(f"Using RocketCEA propellant names: ox='{ox}', fuel='{fu}'")
                return cea
            except Exception as e:
                last_err = e
                continue
    raise RuntimeError(
        "Could not initialize CEA object for Ethanol/LOX with common names.\n"
        "Try printing RocketCEA available propellants for your install, or use a formula string.\n"
        f"Last error: {last_err}"
    )

cea = make_cea_ethanol_lox()

def safe_call(fn, *args, **kwargs):
    try:
        return fn(*args, **kwargs)
    except Exception:
        return np.nan

rows = []
for MR in MR_grid:
    # Combustion temperature [K]
    Tcomb_K = safe_call(cea.get_Tcomb, Pc=Pc_psia, MR=MR)

    # c* from RocketCEA is typically [ft/s]; convert to [m/s]
    cstar_ft_s = safe_call(cea.get_Cstar, Pc=Pc_psia, MR=MR)
    cstar_m_s = cstar_ft_s * 0.3048 if not np.isnan(cstar_ft_s) else np.nan

    # Isp vacuum [s] at expansion ratio eps
    isp_vac_s = safe_call(cea.get_Isp, Pc=Pc_psia, MR=MR, eps=eps)

    # chamber molecular weight and gamma
    mw, gamma = safe_call(cea.get_Chamber_MolWt_gamma, Pc=Pc_psia, MR=MR)

    rows.append({
        "MR_O_F": MR,
        "Pc_bar": Pc_bar,
        "eps": eps,
        "Tcomb_K": Tcomb_K,
        "cstar_m_s": cstar_m_s,
        "Isp_vac_s": isp_vac_s,
        "MolWt": mw,
        "gamma": gamma,
    })

df = pd.DataFrame(rows)
df.head(15), df.tail(15)

df_valid = df.dropna(subset=["Isp_vac_s"])
best_idx = df_valid["Isp_vac_s"].idxmax()
best = df_valid.loc[best_idx]
best

from google.colab import drive
