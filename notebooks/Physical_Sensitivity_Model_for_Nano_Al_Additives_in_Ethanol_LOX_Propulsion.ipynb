def plot_delta_T_for_all_MR(df):
    for mr in sorted(df["MR_used"].unique()):
        sub = df[df["MR_used"] == mr].sort_values("f_loading")

        plt.figure(figsize=(7, 4))
        for eta in eta_values:
            s = sub[sub["eta"] == eta]
            plt.plot(s["f_loading"], s["dT_K"], marker="o", linewidth=2, label=f"eta = {eta}")

        plt.xlabel("Nano-metal mass fraction f")
        plt.ylabel("Delta T (K)")
        plt.title(f"Final model: Delta T vs loading ({primary_material}, MR approx {mr:.3f})")
        plt.grid(True, alpha=0.3)
        plt.legend()

        fig_path = os.path.join(FIG_DIR, f"final_deltaT_{primary_material}_MR_{mr:.3f}.png")
        plt.savefig(fig_path, dpi=300, bbox_inches="tight")
        plt.show()
        print("Saved:", fig_path)

plot_delta_T_for_all_MR(df_final)

def plot_isp_ideal_vs_net(df, mr_to_plot=None):
    if mr_to_plot is None:
        mr_to_plot = best_used

    sub = df[df["MR_used"] == mr_to_plot].sort_values("f_loading")

    plt.figure(figsize=(8, 5))
    for eta in eta_values:
        s = sub[sub["eta"] == eta]
        plt.plot(
            s["f_loading"], s["dIsp_ideal_s"],
            marker="o", linestyle="--", linewidth=2,
            label=f"Ideal dIsp, eta={eta}"
        )
        plt.plot(
            s["f_loading"], s["dIsp_net_s"],
            marker="s", linestyle="-", linewidth=2,
            label=f"Net dIsp, eta={eta}"
        )

    plt.xlabel("Nano-metal mass fraction f")
    plt.ylabel("Delta Isp (s)")
    plt.title(f"Ideal vs net Delta Isp ({primary_material}, MR approx {mr_to_plot:.3f})")
    plt.grid(True, alpha=0.3)
    plt.legend()

    fig_path = os.path.join(FIG_DIR, f"final_ideal_vs_net_dIsp_{primary_material}_MRbest.png")
    plt.savefig(fig_path, dpi=300, bbox_inches="tight")
    plt.show()
    print("Saved:", fig_path)

