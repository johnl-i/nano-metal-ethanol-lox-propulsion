# Check that each mixture sums to 1 and that all species exist in gri30.yaml.
available_species = set(gas.species_names)

for name, mix in product_mixtures.items():
    total = sum(mix.values())
    missing_species = set(mix.keys()) - available_species
    print(f"{name}: sum = {total:.3f}")
    if missing_species:
        raise ValueError(f"{name} contains species not in gri30.yaml: {missing_species}")

def triangular_pulse(t, tau, qtot):
    """Triangular heat-release pulse qdot(t), with total area qtot."""
    if t < 0 or t > tau:
        return 0.0
    qdot_peak = 2.0 * qtot / tau
    if t <= tau / 2.0:
        return qdot_peak * (t / (tau / 2.0))
    return qdot_peak * ((tau - t) / (tau / 2.0))

def simulate_temperature_history(T0, P0, gas, X, tau, qtot, t_end=0.03, dt=1e-5):
    """Integrate T(t) using Cantera cp_mass(T)."""
    ts = np.arange(0.0, t_end + dt, dt)
    T = np.zeros_like(ts)
    T[0] = T0

    for i in range(len(ts) - 1):
        gas.TPX = T[i], P0, X
        cp = gas.cp_mass
        qdot = triangular_pulse(ts[i], tau, qtot)
        T[i + 1] = T[i] + (qdot / cp) * dt

    return ts, T

# Use chamber pressure from baseline if available; otherwise default to 15 bar.
if "Pc_bar" in df_base.columns:
    P0 = float(best_row["Pc_bar"]) * 1e5
else:
    P0 = 15.0e5

tau_s = tau_burn_s
t_end_s = 0.030
dt_s = 1e-5

print("P0 =", P0, "Pa")
print("tau_s =", tau_s, "s")

f_test = 0.03
eta_test = 0.8

base = nearest_baseline_row(df_valid, MR_best)
T0 = float(base["Tcomb_K"])
Isp0 = float(base["Isp_vac_s"])

# Use the more physical useful-energy version.
qtot_useful = eta_test * f_test * Q_metal * timescale_gate * oxide_shell_efficiency

composition_results = []
histories = {}

for mix_name, X_mix in product_mixtures.items():
    ts, Tt = simulate_temperature_history(
        T0=T0,
        P0=P0,
        gas=gas,
        X=X_mix,
        tau=tau_s,
        qtot=qtot_useful,
        t_end=t_end_s,
        dt=dt_s,
    )

    Tend = float(Tt[-1])
    dT_end = Tend - T0
    Isp_new = isp_from_temperature_scaling(Isp0, T0, Tend)
    dIsp = Isp_new - Isp0

    composition_results.append({
        "mixture_case": mix_name,
        "f_loading": f_test,
        "eta": eta_test,
        "T0_K": T0,
        "Tend_K": Tend,
        "dT_end_K": dT_end,
        "Isp0_s": Isp0,
        "dIsp_s": dIsp,
        "qtot_useful_J_per_kg": qtot_useful,
    })
    histories[mix_name] = (ts, Tt)

df_comp = pd.DataFrame(composition_results)
