def nearest_baseline_row(df, mr_target):
    """Return the baseline row whose MR is closest to mr_target."""
    idx = (df["MR_O_F"] - mr_target).abs().idxmin()
    return df.loc[idx]

MR_used_rows = [nearest_baseline_row(df_valid, mr) for mr in MR_targets]

