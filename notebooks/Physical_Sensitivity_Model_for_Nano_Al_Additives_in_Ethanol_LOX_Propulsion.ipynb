            T_new = T0 + dT
            Isp_ideal = isp_from_temperature_scaling(Isp0, T0, T_new)
            dIsp_ideal = Isp_ideal - Isp0

            # Apply a penalty scaled by oxide mass relative to Al case.
            # This is a simple sensitivity assumption, not a calibrated physical law.
            oxide_relative_to_Al = mat_props["oxide_per_kg_metal"] / metal_props["Al"]["oxide_per_kg_metal"]
            penalty = two_phase_penalty_factor(f, two_phase_loss_at_5wt * oxide_relative_to_Al)
            dIsp_net = dIsp_ideal * penalty

            material_rows.append({
                "material": mat,
                "MR_used": MR_used,
                "f_loading": f,
                "eta": eta_test,
                "dT_K": dT,
                "dIsp_net_s": dIsp_net,
                "oxide_name": mat_props["oxide_name"],
            })

